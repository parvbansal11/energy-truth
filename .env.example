# ---- AWS core (AGENTS.md Step 1.A/1.B) -------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
AWS_PROFILE=energy-truth
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-east-1

# ---- Bedrock (Step 1.C) — confirm exact IDs in the console -------------------
BEDROCK_TEXT_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_FAST_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# auto = use Bedrock when AWS credentials resolve; true/false to force
BEDROCK_ENABLED=auto

# ---- Chronos-2 (Step 1.D). Empty endpoint = local CPU inference ---------------
CHRONOS_JUMPSTART_MODEL_ID=pytorch-forecasting-chronos-2
CHRONOS_INSTANCE_TYPE=ml.g5.xlarge
CHRONOS_ENDPOINT_NAME=
CHRONOS_ROLE_ARN=
CHRONOS_QUANTILES=0.1,0.5,0.9
CHRONOS_HORIZON_MONTHS=6

# ---- Data stores (filled by `make deploy` -> scripts/write_outputs_to_env.py) --
S3_RAW_BUCKET=
S3_CURATED_BUCKET=
S3_REPORTS_BUCKET=
DDB_TABLE_PREFIX=energytruth_
OPENSEARCH_ENDPOINT=
OPENSEARCH_COLLECTION_ARN=
# local data root (Lambda uses /tmp/data); leave empty locally
DATA_DIR=

# ---- Auth / API (filled by CDK outputs) ---------------------------------------
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
API_BASE_URL=
WS_URL=
ALERTS_TOPIC_ARN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Notifications / budget (used by CDK at deploy time) ---------------------
ALERT_EMAIL=
BUDGET_EMAIL=

# ---- Frontend / Amplify (Step 1.F) -------------------------------------------
AMPLIFY_REPOSITORY=
AMPLIFY_APP_ID=
FRONTEND_URL=
VITE_API_BASE_URL=/api
VITE_WS_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_AWS_REGION=us-east-1
VITE_LOCATION_MAP_NAME=
VITE_LOCATION_API_KEY=
VITE_GIBS_ENABLED=true
LOCAL_API_URL=http://127.0.0.1:8000

# ---- External sources ----------------------------------------------------------
CEA_EF_TCO2_PER_MWH=0.727
CEA_EF_VERSION=V20_FY2023-24
FIRMS_MAP_KEY=
CARBON_MAPPER_TOKEN=
LOCATION_MAP_NAME=
CUSTOM_DOMAIN=
ROBBIE_INDIA_BASE=https://robbieandrew.github.io/india/data
CLIMATETRACE_API=https://api.climatetrace.org/v7
GEM_API=https://api.globalenergymonitor.org

# ---- App -----------------------------------------------------------------------
HITL_ENTITY_THRESHOLD=0.75
DEMO_COMPANIES=NTPC,TATASTEEL,ULTRACEMCO,JSWSTEEL,ADANIPOWER
# seconds between streamed agent steps (perceptible pacing; 0 in tests)
AGENT_STEP_DELAY=0.35

# ---- AI providers (tried in order; Bedrock first, then Gemini, then a local Ollama model, then templates)
LLM_PROVIDERS=bedrock,gemini,ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
